# Estado interno del workspace de CubeIDE (rutas de cada PC)
.metadata/

# Salidas de compilacion y binarios
**/Debug/
**/Release/
*.o
*.elf
*.map
*.list
*.su
*.exe
*.bak

# Lo regenera CubeIDE y su hash cambia en cada compilacion
**/.settings/language.settings.xml

# Configuracion de Run/Debug de CubeIDE (tiene rutas de cada PC y se regenera sola)
*.launch

# Estado de las vistas de CubeIDE (cambia en cada sesion de depuracion)
**/.settings/com.st.*.prefs

# Cache de Python
__pycache__/
*.pyc

# Proyecto IAR que CubeMX genera y no se usa
**/EWARM/
